---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { robots } from '../lib/content';
// Awards are listed on each season's robot file in content/robots.
const awards = (await robots()).flatMap((r) => r.data.awards.map((a) => {
  const m = a.match(/^(.*?)\s*\((.*)\)$/);
  return { year: r.data.year.slice(0, 4), award: m ? m[1] : a, detail: m ? m[2] : undefined };
}));
---
<Base title="Awards">
  <PageHead title="Awards" />
  <section class="section"><div class="wrap">
    <ul class="aw">{awards.map((a) => <li><b>{a.year}</b><span>{a.award}{a.detail && <small>{a.detail}</small>}</span></li>)}</ul>
  </div></section>
</Base>
<style>
  .aw{list-style:none;columns:2;column-gap:56px}
  .aw li{break-inside:avoid;display:flex;gap:20px;padding:14px 0;border-bottom:1px solid rgba(155,206,225,.2)}
  .aw b{font:900 20px/1.4 var(--head);color:var(--green);min-width:3em;font-variant-numeric:tabular-nums}
  .aw span{display:flex;flex-direction:column}
  .aw small{color:var(--azure);font-size:15px}
  @media (max-width:760px){.aw{columns:1}}
</style>
