---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { robots, parseAward, text, fill } from '../lib/content';
const t = await text('awards');
// Each season's events and the awards won at them live on its robot file in content/robots.
const years = (await robots())
  .filter((r) => r.data.events.length > 0)
  .map((r) => ({ year: r.data.year.slice(0, 4), events: r.data.events.map((e) => ({ ...e, awards: e.awards.map(parseAward) })) }));
const first = years.at(-1)?.year ?? '2014';
const last = years[0]?.year ?? '2026';
---
<Base title={t.title} description={t.lead}>
  <PageHead title={t.title} eyebrow={fill(t.eyebrow, { first, last })} lead={t.lead} />
  <section class="section light after-head"><div class="wrap">
    {years.map((y) => (
      <div class="yr">
        <div class="n">{y.year}</div>
        <ul class="evs">{y.events.map((e) => (
          <li class:list={['ev', { won: e.won }]}>
            <div class="head">
              <span class="en">{e.name}</span>
              {e.level && <span class="tier">{e.level}</span>}
              {e.won && <span class="win">{t.winner_label}</span>}
            </div>
            <ul class="aw">{e.awards.map((a) => (
              <li class:list={{ big: /^(chairman|impact)/i.test(a.name) }}><span class="nm">{a.name}{a.detail && <small>{a.detail}</small>}</span></li>
            ))}</ul>
          </li>
        ))}</ul>
      </div>
    ))}
  </div></section>
</Base>
<style>
  .yr{display:flex;flex-wrap:wrap;gap:12px 40px;border-top:4px solid var(--navy);padding:22px 0;align-items:flex-start}
  .n{font:900 clamp(3.5rem,8vw,6rem)/.8 var(--head);color:var(--navy);flex:0 0 220px;width:220px;font-variant-numeric:tabular-nums}
  ul{list-style:none}
  .evs{flex:1 1 420px;min-width:0;display:grid;gap:14px}
  .ev{border:2px solid var(--navy);padding:14px 18px;background:var(--white)}
  .ev.won{background:var(--green);border-color:var(--navy)}
  .head{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin-bottom:8px}
  .en{font:900 1.25rem/1.1 var(--head);text-transform:uppercase;color:var(--navy)}
  .tier{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;border:2px solid var(--navy);color:var(--navy);padding:2px 8px;white-space:nowrap}
  .win{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;background:var(--navy);color:var(--green);padding:4px 10px;white-space:nowrap}
  .aw{display:grid;gap:6px}
  .aw li{font-size:19px;font-weight:600;color:var(--navy)}
  .nm{display:flex;flex-direction:column}
  small{font-size:15px;font-weight:400;color:var(--grey)}
  .ev.won small{color:var(--navy)}
  .aw li.big .nm{align-self:flex-start;background:var(--green);color:var(--navy);padding:4px 12px;font-weight:800}
  .ev.won .aw li.big .nm{background:var(--navy);color:var(--green)}
  .aw li.big small{padding-left:12px}
</style>
