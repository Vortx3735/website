---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { text } from '../lib/content';
const t = await text('not-found');
---
<Base title={t.title}>
  <PageHead title={t.title} lead={t.lead} />
  <section class="section light after-head"><div class="wrap"><a class="btn btn-dark" href="/">{t.button}</a></div></section>
</Base>
