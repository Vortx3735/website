---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { settings, text } from '../lib/content';
const site = await settings();
const t = await text('calendar');
// The calendar comes from calendar_embed_link in content/settings.md.
const src = site.calendar_embed_link;
---
<Base title={t.title} description={t.lead}>
  <PageHead title={t.title} lead={t.lead} />
  <section class="section light after-head"><div class="wrap">
    {src ? <div class="cal"><iframe src={src} title={t.frame_title} loading="lazy"></iframe></div>
         : <p>{t.fallback}</p>}
    {site.calendar_add_link && <p class="add"><a class="btn btn-dark" href={site.calendar_add_link} rel="noopener">{t.add_button}</a></p>}
  </div></section>
</Base>
<style>
  .add{margin-top:24px}
  .cal{position:relative;aspect-ratio:4/3;max-height:80vh;width:100%}
  .cal iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  @media (max-width:700px){.cal{aspect-ratio:3/4}}
</style>
