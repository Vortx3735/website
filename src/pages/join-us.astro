---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
---
<Base title="Join us" description="No experience required. Join FRC Team 3735 VorTX.">
  <PageHead title="Join our team" lead="No experience required. Open to students at Klein High, Klein Cain, Klein Oak, Klein Collins and Klein Forest." />
  <section class="section cream"><div class="wrap join">
    <ul class="points">
      <li>No experience required to join.</li>
      <li>Different teams and fields to work in: build, code, design, business and outreach.</li>
      <li>An open, friendly environment for anyone interested in robotics.</li>
    </ul>
    <div class="cta">
      <h2 class="h">Fill out the interest form</h2>
      <p>The form opens in Google Forms.</p>
      <a class="btn btn-dark" href={site.joinFormUrl}>Open the form <Icon name="arrow" /></a>
      <p class="small">Questions about meetings? See the <a href="/faq/">FAQ</a>.</p>
    </div>
  </div></section>
</Base>
<style>
  .join{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
  .points{list-style:none;display:grid;gap:18px;font-size:18px}
  .points li{padding-left:28px;position:relative}
  .points li::before{content:"";position:absolute;left:0;top:.55em;width:12px;height:12px;border-radius:50%;background:var(--green)}
  .cta{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
  .small{font-size:14px}
  @media (max-width:760px){.join{grid-template-columns:1fr}}
</style>
