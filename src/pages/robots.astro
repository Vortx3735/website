---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PhotoScroller from '../components/PhotoScroller.astro';
import Lightbox from '../components/Lightbox.astro';
import { robots, robotPhotos, photo, awardLine, parseAward, text, fill } from '../lib/content';
// The newest robot (by year) is featured at the top. Every earlier robot moves into the list and gets its own page at /robots/<note name>/.
const entries = await robots();
const list = await Promise.all(entries.map(async (r) => ({ ...r.data, id: r.id, photos: await robotPhotos(r.data) })));
const t = await text('robots');
const cur = list[0];
const earlier = list.slice(1); // the featured robot isn't repeated in the list
const vals = { year: cur.year, name: cur.name };
const tribute = photo('robots', cur.tribute_photo);
const Story = (await render(entries[0])).Content;
const results = cur.awards.map(awardLine).join(' // ');
const specs = Object.entries(cur.specs ?? {});
const aw = await text('awards');
const events = cur.events.map((e) => ({ ...e, awards: e.awards.map(parseAward) }));
// A heading with its last word highlighted in green.
const head = (h: string) => { const w = h.split(' '); const last = w.pop(); return { first: w.length ? w.join(' ') + ' ' : '', last }; };
---
<Base title="Robots" description={fill(t.description, vals)}>
  <PageHead flat eyebrow={fill(t.eyebrow, vals)} title={fill(t.title, vals)} lead={cur.tagline ?? fill(t.lead, vals)} />
  {results && <div class="results"><div class="wrap">{results}</div></div>}
  <section class="section light story"><div class="wrap two">
    <div class="pic"><div class="frame"><PhotoScroller robot={cur.photos} width={1200} eager auto={Number(t.scroll_seconds) || 0} /></div></div>
    <div class="md"><Story /></div>
  </div></section>
  {cur.tribute_heading && <section class="section grey"><div class="wrap">
    <h2 class="h big">{head(cur.tribute_heading).first}<em>{head(cur.tribute_heading).last}</em></h2>
    <figure class="tribute">{tribute ? <Image src={tribute} alt={cur.tribute_alt ?? cur.tribute_heading} width={1200} /> : <div class="ph">{t.tribute_placeholder}</div>}</figure>
  </div></section>}
  {specs.length > 0 && <section class="section navy"><div class="wrap">
    <h2 class="h big">{head(t.specs_heading).first}<em>{head(t.specs_heading).last}</em></h2>
    <div class="specs">{specs.map(([k, v]) => <div><span>{k.replace(/_/g, ' ')}</span><b>{v}</b></div>)}</div>
  </div></section>}
  {events.length > 0 && <section class="section light"><div class="wrap">
    <h2 class="h big">{t.detail_awards_heading}</h2>
    <ul class="evs">{events.map((e) => (
      <li class:list={['ev', { won: e.won }]}>
        <div class="head"><span class="en">{e.name}</span>{e.level && <span class="tier">{e.level}</span>}{e.won && <span class="win">{aw.winner_label}</span>}</div>
        <ul class="awl">{e.awards.map((a) => <li class:list={{ chair: /^(chairman|impact)/i.test(a.name) }}><span>{a.name}</span>{a.detail && <small>{a.detail}</small>}</li>)}</ul>
      </li>
    ))}</ul>
  </div></section>}
  <section class="section light"><div class="wrap">
    <h2 class="h big">{head(t.all_heading).first}<em>{head(t.all_heading).last}</em></h2>
    <p class="sub">{t.all_lead}</p>
    <ul class="cards">{earlier.map((r) => (
      <li id={r.id}>
        <PhotoScroller robot={r.photos} />
        <a class="info" href={`/robots/${r.id}/`}>
          <div class="yr">{r.year}</div>
          <div class="nm">{r.name}</div>
          <div class="gm">{r.game}</div>
          {r.awards.map((a) => <div class="aw">{awardLine(a)}</div>)}
          <div class="more">{t.view_stats} →</div>
        </a>
      </li>
    ))}</ul>
  </div></section>
</Base>
<Lightbox />
<style>
  .section.grey{background:#f2f2f2;color:black}
  .section.navy{background:var(--navy);color:var(--white)}
  .story{padding-top:72px}
  .two{display:flex;flex-wrap:wrap;gap:56px;align-items:flex-start}
  .two .pic{flex:1 1 560px;position:relative}
  .two .pic::before{content:"";position:absolute;left:-16px;top:-16px;right:40px;bottom:40px;background:var(--green)}
  .two .frame{position:relative;margin:16px 0 0 16px}
  .two .md{flex:1 1 400px;font-size:17px}
  h2.big{font-size:clamp(3rem,7vw,6rem);text-transform:uppercase;color:var(--navy);line-height:.9;margin-bottom:28px}
  h2.big em{font-style:normal;background:var(--green);padding:0 10px}
  .navy h2.big{color:var(--white)}
  .evs{list-style:none;display:grid;gap:14px;max-width:900px}
  .ev{border:2px solid var(--navy);padding:14px 18px;background:var(--white)}
  .ev.won{background:var(--green)}
  .head{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin-bottom:8px}
  .en{font:900 1.25rem/1.1 var(--head);text-transform:uppercase;color:var(--navy)}
  .tier{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;border:2px solid var(--navy);color:var(--navy);padding:2px 8px}
  .win{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;background:var(--navy);color:var(--green);padding:4px 10px}
  .awl{list-style:none;display:grid;gap:6px}
  .awl li{font-size:19px;font-weight:600;color:var(--navy);display:flex;flex-direction:column}
  .awl small{font-size:15px;font-weight:400;color:var(--grey)}
  .ev.won small{color:var(--navy)}
  .awl li.chair span{align-self:flex-start;background:var(--green);padding:4px 12px;font-weight:800}
  .ev.won .awl li.chair span{background:var(--navy);color:var(--green)}
  .tribute{max-width:1000px;margin-inline:auto;border-bottom:8px solid var(--green)}
  .tribute :global(img){width:100%;height:auto;display:block}
  .tribute .ph{aspect-ratio:3/2}
  .ph{display:flex;align-items:center;justify-content:center;text-align:center;background:#e3e8eb;border:2px dashed var(--navy);color:var(--navy);font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:12px}
  .specs{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));border:4px solid var(--green)}
  .specs div{padding:28px;border-right:4px solid var(--green)}
  .specs div:last-child{border-right:0}
  .specs span{display:block;font-weight:800;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--green)}
  .specs b{font:900 2.6rem/1.1 var(--head);text-transform:uppercase}
  .sub{font-size:18px;color:var(--navy);margin:-12px 0 28px}
  .cards{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
  .cards li{border:4px solid var(--navy);background:var(--white);color:var(--navy);scroll-margin-top:100px}
  .info{display:block;padding:16px 18px 18px;color:inherit;text-decoration:none}
  .info .more{margin-top:12px;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--navy)}
  .info:hover .more,.info:focus-visible .more{color:var(--green);background:var(--navy);display:inline-block;padding:4px 8px}
  .yr{font:900 3rem/.9 var(--head)}
  .nm{font-weight:800;font-size:20px;margin-top:6px}
  .gm{font-weight:700;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--grey);margin:2px 0 8px}
  .aw{font-size:14px;padding:3px 0;border-top:1px solid #d9dfe3}
</style>
