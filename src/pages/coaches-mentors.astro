---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import people from '../data/people.json';
---
<Base title="Coaches & mentors">
  <PageHead title="Coaches & mentors" lead="Teachers and volunteers who support the students." />
  <section class="section light"><div class="wrap grid2">
    <div><h2 class="h">Coaches</h2><ul>{people.coaches.map((n) => <li>{n}</li>)}</ul></div>
    <div><h2 class="h">Mentors</h2><ul>{people.mentors.map((n) => <li>{n}</li>)}</ul></div>
  </div></section>
</Base>
<style>
  .grid2{display:grid;grid-template-columns:1fr 2fr;gap:48px}
  ul{list-style:none;columns:2;column-gap:32px}
  .grid2 > div:first-child ul{columns:1}
  li{padding:10px 0;border-bottom:1px solid var(--lgrey);font-weight:600;break-inside:avoid}
  @media (max-width:700px){.grid2{grid-template-columns:1fr}}
</style>
