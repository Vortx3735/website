---
// Renders every Markdown page in content/pages (except home.md) at /<file name>/.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { settings } from '../lib/content';

export async function getStaticPaths() {
  // home.md is the homepage, and the About pages are all shown together at /about/ (src/pages/about.astro).
  const pages = await getCollection('pages', (p) => !['home', 'about', 'our-mission', 'our-history', 'leadership', 'coaches-mentors'].includes(p.id));
  return pages.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const { title, lead, description, button_label, button_link } = p.data;
const formEmbed = p.id === 'join-us' ? (await settings()).join_form_embed : null;
---
<Base title={title} description={description ?? lead}>
  <PageHead title={title} lead={lead} />
  <section class="section light after-head"><div class="wrap prose md" class:list={{ faq: p.id === 'faq' }}>
    <Content />
    {formEmbed && <iframe class="gform" src={formEmbed} title="VorTX student interest form" loading="lazy">Loading…</iframe>}
    {button_label && button_link && <p class="cta"><a class="btn btn-dark" href={button_link}>{button_label} <Icon name="arrow" /></a></p>}
  </div></section>
</Base>

<script>
  // FAQ: turn each "## question" and its answer into an accordion that eases open.
  const faq = document.querySelector('.md.faq');
  if (faq) {
    [...faq.querySelectorAll('h2')].forEach((h) => {
      const d = document.createElement('details');
      const s = document.createElement('summary');
      s.textContent = h.textContent;
      d.append(s);
      let n = h.nextElementSibling;
      while (n && n.tagName !== 'H2') { const next = n.nextElementSibling; d.append(n); n = next; }
      h.replaceWith(d);
    });
    faq.classList.add('ready');
  }
</script>

<style>
  .gform{display:block;width:100%;height:1700px;border:0;margin-top:32px;background:var(--cream)}
  @media (max-width:700px){.gform{height:2100px}}
  /* FAQ accordion */
  .faq.ready{max-width:960px}
  .faq :global(details){border-bottom:4px solid var(--navy);padding:20px 0;interpolate-size:allow-keywords}
  .faq :global(details:first-of-type){border-top:4px solid var(--navy)}
  .faq :global(summary){cursor:pointer;list-style:none;font:900 clamp(1.5rem,3vw,2.2rem)/1.1 var(--head);color:var(--navy);transition:padding-left .3s}
  .faq :global(summary::-webkit-details-marker){display:none}
  .faq :global(summary::after){content:"+";float:right;color:var(--green);transition:transform .35s}
  .faq :global(details[open] summary::after){transform:rotate(45deg)}
  .faq :global(summary:hover){padding-left:12px}
  .faq :global(details > :not(summary)){max-width:720px;margin-top:12px}
  .faq :global(details::details-content){block-size:0;overflow:hidden;opacity:0;transition:block-size .45s cubic-bezier(.2,.8,.2,1),opacity .35s,content-visibility .45s allow-discrete}
  .faq :global(details[open]::details-content){block-size:auto;opacity:1}
  @media (prefers-reduced-motion:reduce){.faq :global(details::details-content),.faq :global(summary),.faq :global(summary::after)}
</style>
