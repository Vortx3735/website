---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { settings, text } from '../lib/content';
const site = await settings() as Record<string, any>;
const t = await text('resources');
type Card = { title: string; text: string; button: string; link: string };
// A card link can be a web address, a page, a file in public/, or the name of a link in settings.
const href = (l: string) => (site[l] ?? l) as string;
const isFile = (l: string) => /^\/(images|files)\//.test(href(l));
---
<Base title={t.title} description={t.lead}>
  <PageHead title={t.title} lead={t.lead} />
  <section class="section light after-head"><div class="wrap">
    <h2 class="h">{t.basics_heading}</h2>
    <ul class="sw">{(t.swatches as { name: string; hex: string }[]).map((c) => <li><i style={`background:${c.hex}`}></i><b>{c.name}</b><span>{c.hex}</span></li>)}</ul>
    <p class="rules"><b>{t.rules_label}</b> {t.rules}</p>
  </div></section>
  <section class="section navy"><div class="wrap">
    <div class="cards">
      {(t.cards as Card[]).map((c) => (
        <article><h2>{c.title}</h2><p>{c.text}</p><a class="btn btn-go" href={href(c.link)} rel="noopener" download={isFile(c.link) ? '' : undefined}>{c.button}</a></article>
      ))}
    </div>
  </div></section>
</Base>
<style>
  .section.navy{background:var(--navy);color:var(--white);border-bottom:6px solid var(--green)}
  .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
  .cards article{border:2px solid var(--green);padding:28px;display:flex;flex-direction:column;align-items:flex-start;gap:14px}
  .cards h2{font-family:var(--head);text-transform:uppercase;font-size:2rem;line-height:1;color:var(--white)}
  .cards p{flex:1;font-size:1.05rem}
  h2.h{font-size:clamp(2.6rem,5vw,4.5rem);text-transform:uppercase;color:var(--navy);margin-bottom:24px;line-height:.9}
  .sw{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-bottom:28px}
  .sw i{display:block;height:90px;border:1px solid #ccc;margin-bottom:8px}
  .sw b{display:block;color:var(--navy)}
  .sw span{font-size:14px;color:var(--grey);text-transform:uppercase}
  .rules{max-width:640px}
</style>
