---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
---
<Base title="Support us" description="Sponsor FRC Team 3735 VorTX.">
  <PageHead title="Sponsor us" lead="To keep growing, we are looking for sponsors." />
  <section class="section cream"><div class="wrap prose">
    <p>If you are interested in sponsorship opportunities, please review our sponsorship package.</p>
    <p style="margin-top:24px"><a class="btn btn-dark" href={site.sponsorPacketUrl}>See the 2026–27 package (PDF) <Icon name="arrow" /></a></p>
    <p style="margin-top:24px">Questions? <a href="/contact-us/">Contact us</a>.</p>
  </div></section>
</Base>
