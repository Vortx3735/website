---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { page, robots, sponsors, photo } from '../lib/content';
import { existsSync } from 'node:fs';

const home = (await page('home')).data as Record<string, string>;
const all = await robots();
const current = all[0].data;
const rail = all.map((r) => ({
  ...r.data,
  img: photo('robots', r.data.photos[0]),
  award: r.data.awards.find((a) => !a.startsWith("Dean's List")),
  long: r.data.year.length > 4,
}));
// The time-lapse video and its still frame live in public/media/.
const video = existsSync('public/media/build-season-timelapse.mp4') ? '/media/build-season-timelapse.mp4' : null;
const poster = '/media/build-season-timelapse.jpg';
const sponsorList = (await sponsors()).map((s) => s.data);
---
<Base overlayHeader>
  <section class="hero">
    <div class="photo hero-media">
      <img src={poster} alt="" fetchpriority="high">
      {video && <video autoplay muted loop playsinline preload="metadata" poster={poster} src={video}></video>}
      {video && <button class="vidctl" type="button" aria-label="Pause the time-lapse" aria-pressed="false">
        <svg class="i-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="3" height="10" rx="1"/><rect x="9" y="3" width="3" height="10" rx="1"/></svg>
        <svg class="i-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3l8 5-8 5z"/></svg>
      </button>}
    </div>
    <div class="wrap hero-in">
      <h1 class="h">{home.headline} <em>{home.headline_highlight}</em></h1>
      <div class="plate">
        <dl>
          <dt>{current.year} robot</dt><dd>{current.name} · {current.game}</dd>
          {home.robot_named_for && <><dt>Named for</dt><dd>{home.robot_named_for}</dd></>}
          {current.awards.length > 0 && <><dt>Honors</dt><dd>{current.awards.join(' · ')}</dd></>}
        </dl>
        <div class="acts">
          <a class="btn btn-go" href="/join-us/">Join the team <Icon name="arrow" /></a>
          <a class="btn btn-line" href="/support-us/">Sponsor us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="seasons">
    <div class="wrap">
      <div class="seasons-head">
        <h2 class="h">{home.seasons_heading}</h2>
        <p>{home.seasons_text} <a href="/robots/">See all robots</a></p>
      </div>
      <div class="rail" tabindex="0" aria-label="Robots by season, scroll sideways">
        {rail.map((r, i) => (
          <article class:list={['yr', { now: i === 0 }]}>
            <div class="photo">{r.img && <Image src={r.img} alt={`${r.name}, our ${r.year} robot`} width={480} />}</div>
            <div class="t">
              <b class:list={{ long: r.long }}>{r.year}</b>
              <h3>{r.name}</h3>
              <small>{r.game}</small>
              {r.award && <div class="aw"><Icon name="trophy" />{r.award}</div>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="asks">
    <div class="ask join">
      <h2 class="h">{home.join_heading}</h2>
      <p>{home.join_text}</p>
      <a class="btn btn-dark" href="/join-us/">Join the team</a>
    </div>
    <div class="ask back">
      <h2 class="h">{home.sponsor_heading}</h2>
      <p>{home.sponsor_text}</p>
      <ul class="sp">{sponsorList.map((s) => <li>{s.website ? <a href={s.website} rel="noopener">{s.name}</a> : s.name}</li>)}</ul>
      <a class="btn btn-go" href="/support-us/">Sponsor us</a>
    </div>
  </section>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.vidctl');
  const vid = document.querySelector<HTMLVideoElement>('.hero-media video');
  if (btn && vid) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const set = (paused: boolean) => {
      btn.setAttribute('aria-pressed', String(paused));
      btn.setAttribute('aria-label', paused ? 'Play the time-lapse' : 'Pause the time-lapse');
    };
    if (reduce.matches) { vid.pause(); vid.removeAttribute('autoplay'); set(true); }
    btn.addEventListener('click', () => { if (vid.paused) { vid.play(); set(false); } else { vid.pause(); set(true); } });
  }
</script>

<style>
  .hero{min-height:min(100svh,960px);display:grid;align-items:end;position:relative;padding-top:120px}
  .hero-media{position:absolute;inset:0}
  .hero-media img,.hero-media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .hero-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(1,33,49,.8) 0%,rgba(1,33,49,.55) 30%,rgba(1,33,49,.7) 60%,rgba(1,33,49,.96) 100%)}
  .vidctl{position:absolute;z-index:2;right:var(--gutter);bottom:20px;width:44px;height:44px;border-radius:50%;border:0;background:rgba(1,33,49,.72);color:var(--white);display:grid;place-items:center;cursor:pointer;transition:background .3s var(--ease),color .3s var(--ease)}
  .vidctl:hover{background:var(--green);color:var(--deep)}
  .vidctl svg{width:16px;height:16px;grid-area:1/1}
  .vidctl .i-play,.vidctl[aria-pressed="true"] .i-pause{display:none}
  .vidctl[aria-pressed="true"] .i-play{display:block}
  .hero-in{position:relative;z-index:1;padding:0 0 72px;display:grid;grid-template-columns:1.4fr 1fr;gap:48px;align-items:end}
  .hero h1{font-size:clamp(3rem,7vw,6rem)}
  .hero h1 em{font-style:normal;color:var(--green)}
  .plate{border-top:2px solid var(--green);padding-top:18px}
  .plate dl{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;font-size:18px;margin-bottom:24px}
  .plate dt{color:var(--azure);font-weight:600;letter-spacing:.08em;text-transform:uppercase;font-size:14px;padding-top:2px}
  .acts{display:flex;gap:12px;flex-wrap:wrap}
  .seasons{padding:96px 0 80px;background:var(--navy)}
  .seasons-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:36px}
  .seasons h2{font-size:clamp(2.2rem,4vw,3.5rem)}
  .seasons-head p{max-width:42ch;color:var(--azure)}
  .seasons-head a{color:var(--white);font-weight:600}
  .rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(230px,1fr);grid-template-rows:auto auto auto auto 1fr;column-gap:2px;row-gap:0;overflow-x:auto;padding-bottom:14px;scroll-snap-type:x mandatory;overscroll-behavior-x:contain}
  /* Each card shares the rail's rows (subgrid), so years, names, games and awards line up across cards. */
  .yr{scroll-snap-align:start;background:var(--deep);display:grid;grid-row:span 5;grid-template-rows:subgrid}
  .yr .photo{aspect-ratio:4/5}
  .yr .t{display:contents}
  .yr .t > *{padding-inline:18px}
  .yr b{padding-top:18px}
  .yr h3{margin-top:6px}
  .yr b{font:900 44px/1 var(--head);color:var(--green);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .yr b.long{font-size:32px;line-height:44px}
  .yr h3{font:900 22px/1.05 var(--head);text-transform:uppercase}
  .yr small{font-size:16px;color:var(--azure);margin-top:6px;line-height:1.5}
  .yr .aw{align-self:start;padding-top:14px;padding-bottom:22px;line-height:1.5;font-size:15px;font-weight:600;color:var(--cream);display:flex;gap:8px;align-items:flex-start}
  .yr .aw :global(svg){flex:none;width:14px;height:14px;margin-top:2px;color:var(--green)}
  .yr.now{box-shadow:inset 0 3px 0 var(--green)}
  .yr.now b{color:var(--white)}
  .asks{display:grid;grid-template-columns:1fr 1fr}
  .ask{padding:88px 64px;display:flex;flex-direction:column;gap:18px;align-items:flex-start}
  .ask.join{padding-left:max(16px,calc((100vw - 1240px)/2));background:var(--cream);color:var(--black)}
  .ask.back{padding-right:max(16px,calc((100vw - 1240px)/2));background:var(--deep)}
  .ask h2{font-size:clamp(2rem,3.5vw,3rem)}
  .ask.join h2{color:var(--navy)}
  .ask p{max-width:46ch}
  .sp{list-style:none;display:flex;flex-wrap:wrap;gap:10px 26px;font-weight:700;font-size:18px;color:var(--lgrey)}
  .sp a{color:inherit;text-decoration:underline;text-decoration-color:rgba(188,188,188,.4);text-underline-offset:.25em}
  .sp a:hover{color:var(--green);text-decoration-color:currentColor}
  @media (max-width:860px){
    .hero-in{grid-template-columns:1fr;gap:28px}
    .asks{grid-template-columns:1fr}
    .ask,.ask.join,.ask.back{padding:64px var(--gutter)}
    .seasons-head{flex-direction:column;align-items:flex-start}
  }
  @media (prefers-reduced-motion:reduce){.hero-media video{display:none}}
</style>
