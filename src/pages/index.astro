---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Rings from '../components/Rings.astro';
import { page, robots, sponsors, photo, galleryPhotos, settings, parseAward, text } from '../lib/content';

const home = (await page('home')).data as Record<string, string>;
const site = await settings();
const t = await text('home');
const g = await text('gallery');
const all = await robots();
const current = all[0];
const currentImg = photo('robots', current.data.photos[0]);
// Awards ticker: judged awards and results since 2019, newest first.
const ticker = all.filter((r) => Number(r.data.year.slice(0, 4)) >= Number(t.ticker_from_year)).flatMap((r) =>
  r.data.awards.map(parseAward).map((a) => `${r.data.year.slice(0, 4)} ${a.name}${a.detail ? ` (${a.detail})` : ''}`));
const allShots = galleryPhotos();
const shots = Array.from({ length: 6 }, (_, i) => allShots[i] ?? null);
// Hero background picture.
const poster = '/images/arena-hero.jpg';
const sponsorList = (await sponsors()).map((s) => ({ ...s.data, img: photo('sponsors', s.data.logo) }));
const primary = sponsorList.filter((s) => s.tier === 'primary');
const supporting = sponsorList.filter((s) => s.tier !== 'primary');
const [schoolsA, ...schoolsB] = (home.schools_heading ?? '').split(',');
---
<Base>
  <section class="hero">
    <div class="photo hero-media">
      <img src={poster} alt="" fetchpriority="high">
    </div>
    <div class="storm" aria-hidden="true"><div class="glow"></div><Rings /></div>
    <div class="wrap hero-in">
      <img class="tri" src="/images/triangle-white.png" alt="" width="102" height="88">
      <p class="eyebrow">{t.hero_eyebrow}</p>
      <h1 class="outline reveal">{home.headline} <em>{home.headline_highlight}</em></h1>
      <div class="acts"><a class="btn btn-go" href="/join-us/">{t.hero_button} <Icon name="arrow" /></a></div>
    </div>
  </section>

  <div class="band" aria-label="Awards">
    <div class="tilt"><div class="run">
      <span>{ticker.map((t) => <>{t} // </>)}</span>
      <span aria-hidden="true">{ticker.map((t) => <>{t} // </>)}</span>
    </div></div>
  </div>

  <section class="count" data-kickoff={site.kickoff_iso} aria-label="Countdown to kickoff">
    <div class="wrap in">
      <div class="lbl"><p class="eyebrow">{t.countdown_eyebrow}</p><div class="h big">{t.countdown_heading}</div>{site.kickoff_label && <p class="when">{site.kickoff_label}</p>}</div>
      <div class="tiles">
        {['days', 'hours', 'minutes', 'seconds'].map((u) => <div class="tile"><div class="num" data-unit={u}>00</div><div class="u">{u}</div></div>)}
      </div>
    </div>
  </section>

  <section class="robot light">
    <div class="wrap">
      <div class="pic"><div class="photo">{currentImg && <Image src={currentImg} alt={`${current.data.name}, our ${current.data.year} robot`} width={1000} />}</div></div>
      <div class="card">
        {current.data.dedication && <p class="eyebrow">{current.data.dedication}</p>}
        <h2 class="h">{current.data.name}</h2>
        <p class="game">{current.data.year} · {current.data.game}</p>
        <a class="more" href="/robots/">{home.robot_link_label} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="schools light">
    <div class="wrap">
      <h2 class="h">{schoolsA}{schoolsB.length > 0 && <>,<br><span>{schoolsB.join(',').trim()}</span></>}</h2>
      <p>{home.schools_text}</p>
    </div>
  </section>

  <section class="strip light">
    <div class="wrap">
      <div class="strip-head"><h2 class="h">{home.gallery_heading}</h2><a class="more" href="/gallery/">{t.gallery_link_label} <Icon name="arrow" /></a></div>
      <ul>{shots.map((img) => img ? <li class="photo"><Image src={img} alt="" width={420} /></li> : <li class="ph">{g.placeholder_label}</li>)}</ul>
    </div>
  </section>

  <section class="asks">
    <div class="ask join">
      <h2 class="h">{home.join_heading}</h2>
      <p>{home.join_text}</p>
      <a class="btn btn-go" href="/join-us/">{t.join_button}</a>
    </div>
    <div class="ask back">
      <h2 class="h">{home.sponsor_heading}</h2>
      <p>{home.sponsor_text}</p>
      <a class="btn btn-go" href="/support-us/">{t.sponsor_button}</a>
    </div>
  </section>
  <section class="section light spons"><div class="wrap">
    <p class="spons-h">{t.sponsors_headline} <em>{t.sponsors_highlight}</em></p>
    <ul class="lg big">{primary.map((s) => <li>{s.website ? <a href={s.website} rel="noopener" aria-label={`${s.name} website`}>{s.img ? <Image src={s.img} alt={s.name} width={480} /> : s.name}</a> : (s.img ? <Image src={s.img} alt={s.name} width={480} /> : s.name)}</li>)}</ul>
    <ul class="lg">{supporting.map((s) => <li>{s.website ? <a href={s.website} rel="noopener" aria-label={`${s.name} website`}>{s.img ? <Image src={s.img} alt={s.name} width={320} /> : s.name}</a> : (s.img ? <Image src={s.img} alt={s.name} width={320} /> : s.name)}</li>)}</ul>
  </div></section>
</Base>

<script>
  // Countdown to kickoff: reads the date from content/settings.md (kickoff_iso).
  const box = document.querySelector<HTMLElement>('[data-kickoff]');
  const target = Date.parse(box?.dataset.kickoff ?? '');
  if (box && !Number.isNaN(target)) {
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const sec = Math.max(0, Math.floor((target - Date.now()) / 1000));
      const v: Record<string, number> = { days: Math.floor(sec / 86400), hours: Math.floor((sec % 86400) / 3600), minutes: Math.floor((sec % 3600) / 60), seconds: sec % 60 };
      for (const k in v) { const e = box.querySelector(`[data-unit="${k}"]`); if (e) e.textContent = k === 'days' && v.days > 99 ? String(v.days) : pad(v[k]); }
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .eyebrow{font-weight:700;font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:var(--green)}
  /* Hero. The bottom edge is slanted; everything below it overlaps the slant. */
  .hero{position:relative;overflow:hidden;min-height:min(92svh,860px);display:grid;align-items:end;clip-path:polygon(0 0,100% 0,100% calc(100% - var(--s)),0 100%);padding-bottom:calc(var(--s) + 24px)}
  .hero-media{position:absolute;inset:0}
  .hero-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .hero-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,51,76,.8) 0%,rgba(0,51,76,.7) 50%,rgba(1,33,49,.96) 100%)}
  .storm{position:absolute;right:-270px;top:-80px;width:900px;aspect-ratio:1;pointer-events:none}
  .glow{position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,transparent 0%,rgba(127,194,65,.5) 50%,transparent 100%);-webkit-mask:radial-gradient(circle,transparent 24%,#000 40%,#000 52%,transparent 68%);mask:radial-gradient(circle,transparent 24%,#000 40%,#000 52%,transparent 68%);animation:spin 14s linear infinite}
  .storm :global(.rings){position:absolute;inset:14.5%;width:71%;height:71%;animation:spin 36s linear infinite;opacity:.95}
  .hero-in{position:relative;z-index:1;padding-top:120px}
  .tri{width:102px;height:auto;margin-bottom:20px}
  .hero-in .eyebrow{margin-bottom:16px}
  .hero h1{font-size:clamp(4rem,12.5vw,11rem);-webkit-text-stroke:3px var(--white);margin-bottom:34px}
  /* Awards band. The text is tilted to the same angle as the strip, at every width. */
  .band{position:relative;z-index:2;background:var(--green);color:var(--navy);margin-top:calc(var(--s) * -1);padding:calc(var(--s) * .95) 0;clip-path:polygon(0 var(--s),100% 0,100% calc(100% - var(--s)),0 100%)}
  .tilt{overflow:hidden;padding:16px 0;width:110%;margin-left:-5%;transform:rotate(-2.862deg)}
  .run{display:flex;width:max-content;font:900 clamp(1.4rem,2.4vw,2.1rem)/1.2 var(--head);text-transform:uppercase;letter-spacing:.02em;white-space:nowrap;animation:run 60s linear infinite}
  .run span{padding-right:48px}
  @keyframes run{to{transform:translateX(-50%)}}
  /* Countdown: slanted top, flat bottom, timer sits on the bottom edge. */
  .count{position:relative;z-index:1;background:var(--navy);margin-top:calc(var(--s) * -1);padding-top:calc(var(--s) + 40px);padding-bottom:56px;clip-path:polygon(0 var(--s),100% 0,100% 100%,0 100%)}
  .count .in{display:flex;flex-wrap:wrap;gap:24px 40px;align-items:flex-end;justify-content:space-between}
  .count .big{font-size:clamp(3.5rem,7vw,6.25rem);text-transform:uppercase;line-height:.9}
  .when{margin-top:10px;font-size:15px}
  .tiles{display:flex;flex-wrap:wrap;gap:10px}
  .tile{background:var(--white);color:var(--navy);padding:14px 22px;min-width:104px;text-align:center}
  .num{font:900 56px/.95 var(--head);font-variant-numeric:tabular-nums}
  .u{font-weight:800;font-size:11px;letter-spacing:.16em;text-transform:uppercase}
  /* Robot card */
  .robot{padding:80px 0 72px}
  .robot .wrap{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);align-items:center;gap:0}
  .robot .pic{position:relative;max-width:900px}
  .robot .pic::before{content:"";position:absolute;left:-16px;top:-16px;right:40px;bottom:40px;background:var(--green)}
  .robot .photo{position:relative;aspect-ratio:3/2;margin:16px 0 0 16px}
  .card{position:relative;margin-left:-90px;background:var(--navy);color:var(--white);padding:44px}
  .card h2{color:var(--white);font-size:clamp(3rem,6vw,5.5rem);text-transform:uppercase;margin:10px 0 8px}
  .game{font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:15px;margin-bottom:18px}
  .more{color:var(--green);font-weight:800;letter-spacing:.06em;text-transform:uppercase;font-size:14px;text-decoration:none;display:inline-flex;gap:.6em;align-items:center}
  .more :global(svg){width:16px;height:16px}
  .light .more{color:var(--navy)}
  .card .more{color:var(--green)}
  .schools{padding:24px 0 88px}
  .schools .wrap{display:flex;flex-wrap:wrap;gap:32px 48px;align-items:flex-end;justify-content:space-between}
  .schools h2{flex:1 1 520px;font-size:clamp(3.5rem,8vw,8rem);text-transform:uppercase;line-height:.86;color:var(--navy)}
  .schools h2 span{background:var(--green);padding:0 14px}
  .schools p{flex:1 1 380px;max-width:520px;font-size:19px;color:var(--black)}
  .strip{padding:0 0 88px}
  .strip-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:28px}
  .strip h2{font-size:clamp(2.6rem,5vw,4.5rem);text-transform:uppercase;color:var(--navy)}
  .strip ul{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px}
  .strip li{aspect-ratio:4/3;border-bottom:6px solid var(--green)}
  .strip li.ph{display:flex;align-items:center;justify-content:center;background:#e3e8eb;border:2px dashed var(--navy);color:var(--navy);font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase}
  .asks{display:grid;grid-template-columns:1fr 1fr}
  .ask{padding:88px 64px;display:flex;flex-direction:column;gap:18px;align-items:flex-start}
  .ask.join{padding-left:max(16px,calc((100vw - 1240px)/2));background:var(--navy);color:var(--white);border-right:4px solid var(--green)}
  .ask.back{padding-right:max(16px,calc((100vw - 1240px)/2));background:var(--navy)}
  .ask h2{font-size:clamp(2rem,3.5vw,3rem)}
  .ask.join h2{color:var(--green)}
  .ask p{max-width:46ch}
  .spons{padding:88px 0}
  .spons-h{font:900 clamp(2.6rem,5.5vw,5rem)/.98 var(--head);text-transform:uppercase;color:var(--navy);max-width:1000px;margin-bottom:36px}
  .spons-h em{font-style:normal;background:var(--green);padding:0 10px}
  .lg{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:16px}
  .lg.big{grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}
  .lg li{background:var(--white);border:1px solid #e4e4e4;height:112px;display:grid;place-items:center;padding:16px;text-align:center;font-weight:700;color:var(--navy)}
  .lg.big li{height:200px;padding:28px;border:2px solid var(--navy)}
  .lg a{display:grid;place-items:center;width:100%;height:100%}
  .lg img{max-height:72px;max-width:100%;width:auto;object-fit:contain}
  .lg.big img{max-height:140px}
  .lg li:hover{border-color:var(--green)}
  @keyframes spin{to{transform:rotate(360deg)}}
  @media (max-width:1000px){
    .hero,.band,.count{clip-path:none;margin-top:0;padding-bottom:40px}
    .hero{padding-bottom:56px}
    .band{padding:12px 0}
    .tilt{transform:none;width:auto;margin-left:0}
    .count{padding-top:48px}
    .robot .wrap{grid-template-columns:1fr}
    .card{margin:-40px 0 0 24px}
    .asks{grid-template-columns:1fr}
    .ask,.ask.join,.ask.back{padding:64px var(--gutter)}
    .ask.join{border-right:0;border-bottom:4px solid var(--green)}
    .glow,.storm :global(.rings),.run{animation:none}
    }
  @media (prefers-reduced-motion:reduce),(pointer:coarse){.glow,.storm :global(.rings),.run{animation:none}}
</style>
