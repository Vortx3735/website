---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import PageHead from '../../components/PageHead.astro';
import { posts, photo, text } from '../../lib/content';

export async function getStaticPaths() {
  const list = await posts(); // newest first
  return list.map((p, i) => ({ params: { slug: p.id }, props: { p, newer: list[i - 1] ?? null, older: list[i + 1] ?? null } }));
}
const { p, newer, older } = Astro.props;
const t = await text('blog');
const { Content } = await render(p);
// Render the post, then turn each photo that has a caption (text in the square brackets) into a figure.
const html = (await (await AstroContainer.create()).renderToString(Content)).replace(
  /<p>\s*(<img\b[^>]*>)\s*<\/p>/g,
  (m, tag) => {
    const cap = (tag.match(/\balt="([^"]*)"/)?.[1] ?? '').trim();
    return cap ? `<figure class="post-fig">${tag}<figcaption>${cap}</figcaption></figure>` : `<figure class="post-fig">${tag}</figure>`;
  },
);
const img = photo('blog', p.data.cover);
const date = p.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={p.data.title} description={p.data.summary ?? undefined}>
  <PageHead title={t.title} />
  <section class="section light after-head"><div class="wrap">
    <article class="post">
      <a class="btn btn-dark back" href="/blog/">&larr; {t.back_label}</a>
      <h2 class="title">{p.data.title}</h2>
      <p class="meta">{t.published_label} <time datetime={p.data.date.toISOString()}>{date}</time>{p.data.author && <> · {t.by_label} {p.data.author}</>}</p>
      {img && (
        <figure class="post-fig cover">
          <Image src={img} alt={p.data.cover_caption ?? ''} width={1200} />
          {p.data.cover_caption && <figcaption>{p.data.cover_caption}</figcaption>}
        </figure>
      )}
      <div class="md body"><Fragment set:html={html} /></div>
      {(older || newer) && (
        <nav class="pager" aria-label="More posts">
          {older ? <a class="btn btn-dark" href={`/blog/${older.id}/`} rel="prev"><span>&larr; {t.prev_label}</span><b>{older.data.title}</b></a> : <span></span>}
          {newer ? <a class="btn btn-dark next" href={`/blog/${newer.id}/`} rel="next"><span>{t.next_label} &rarr;</span><b>{newer.data.title}</b></a> : <span></span>}
        </nav>
      )}
    </article>
  </div></section>
</Base>
<style>
  .post{max-width:760px}
  .title{font:900 clamp(2rem,4.5vw,3.2rem)/1 var(--head);text-transform:uppercase;color:var(--navy);margin:0}
  .meta{margin-top:12px;font-size:14px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--grey)}
  .body{margin-top:28px}
  .back{margin-bottom:28px}
  .pager{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:48px}
  .pager .btn{flex-direction:column;align-items:flex-start;gap:6px;white-space:normal;max-width:46%;text-transform:none}
  .pager .btn span{text-transform:uppercase;font-size:13px;letter-spacing:.08em;color:var(--green)}
  .pager .btn b{font:800 18px/1.15 var(--head)}
  .pager .next{align-items:flex-end;text-align:right;margin-left:auto}
  @media (max-width:600px){.pager .btn{max-width:100%;width:100%}}
  figure.post-fig,.body :global(figure.post-fig){margin:28px 0}
  figure.post-fig img,.body :global(figure.post-fig img){width:100%;height:auto;border-radius:4px;display:block}
  figure.post-fig figcaption,.body :global(figure.post-fig figcaption){margin-top:8px;font-size:14px;line-height:1.4;color:var(--grey)}
</style>
