---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { galleryPhotos } from '../lib/content';
// Photos saved in content/gallery/assets fill the tiles in order; the rest stay placeholders. Photos of students need a media release.
const real = galleryPhotos();
const spans = ['big', '', '', '', '', 'wide', '', ''];
const sections = ['On the field', 'In the shop'].map((title, n) => ({
  title,
  tiles: spans.map((span, i) => ({ span, img: real[n * 8 + i] ?? null })),
}));
---
<Base title="Gallery" description="Photos from VorTX seasons since 2011.">
  <PageHead title="Our Gallery" lead="Competitions, shop days and outreach." />
  {sections.map((sec, n) => (
    <section class:list={['section', n === 0 ? 'light after-head' : 'grey']}><div class="wrap">
      <h2 class="h">{sec.title}</h2>
      <div class="grid">{sec.tiles.map((t) => (
        <div class:list={['tile', t.span, { ph: !t.img }]}>{t.img ? <Image src={t.img} alt="" width={900} /> : 'Photo'}</div>
      ))}</div>
    </div></section>
  ))}
</Base>
<style>
  .section.grey{background:#f2f2f2;color:black}
  h2.h{font-size:clamp(2.6rem,5vw,4.5rem);text-transform:uppercase;color:var(--navy);margin-bottom:24px;line-height:.9}
  .grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:220px;gap:12px}
  .tile{overflow:hidden}
  .tile.big{grid-column:span 2;grid-row:span 2}
  .tile.wide{grid-column:span 2}
  .tile :global(img){width:100%;height:100%;object-fit:cover}
  .tile.ph{display:flex;align-items:center;justify-content:center;background:#e3e8eb;border:2px dashed var(--navy);color:var(--navy);font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase}
  @media (max-width:800px){.grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:160px}}
</style>
