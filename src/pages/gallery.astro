---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { robots, photo } from '../lib/content';
// Every robot photo in content/robots, newest season first. Photos of students need a media release.
const shots = (await robots()).flatMap((r) => r.data.photos.map((p) => ({ img: photo('robots', p), year: r.data.year.slice(0, 4), name: r.data.name, id: r.id })).filter((s) => s.img));
---
<Base title="Gallery" description="Photos from VorTX seasons since 2011.">
  <PageHead title="Our Gallery" lead="Competitions, shop days and outreach." />
  <section class="section light after-head"><div class="wrap">
    <ul class="grid">{shots.map((s) => (
      <li><a href={`/robots/#${s.id}`}><div class="photo"><Image src={s.img} alt={`${s.name}, our ${s.year} robot`} width={520} /></div><span>{s.year} · {s.name}</span></a></li>
    ))}</ul>
  </div></section>
</Base>
<style>
  .grid{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
  .grid a{display:block;text-decoration:none;color:var(--navy);font-weight:700;font-size:15px;letter-spacing:.04em;text-transform:uppercase}
  .grid .photo{aspect-ratio:4/3;border-bottom:6px solid var(--green);transition:transform .25s,box-shadow .25s}
  .grid a:hover .photo{transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--navy)}
  .grid span{display:block;padding-top:8px}
  @media (prefers-reduced-motion:reduce){.grid .photo{transition:none}}
</style>
