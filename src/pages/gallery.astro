---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { galleryPhotos, text } from '../lib/content';
// Photos saved in content/gallery/<section>/ fill the tiles in file-name order; empty tiles stay placeholders.
// Photos of students need a media release.
const spans = ['big', '', '', '', '', 'wide', '', ''];
const g = await text('gallery');
const sections = (g.sections as { title: string; folder: string }[]).map((sec) => {
  const real = galleryPhotos(sec.folder);
  const count = Math.max(8, Math.ceil(real.length / 8) * 8); // whole blocks of 8 so the grid stays full
  return { title: sec.title, tiles: Array.from({ length: count }, (_, i) => ({ span: spans[i % 8], img: real[i] ?? null })) };
});
---
<Base title={g.title} description={g.lead}>
  <PageHead title={g.title} lead={g.lead} />
  {sections.map((sec, n) => (
    <section class:list={['section', n === 0 ? 'light after-head' : n % 2 === 1 ? 'grey' : 'light']}><div class="wrap">
      <h2 class="h">{sec.title}</h2>
      <div class="grid">{sec.tiles.map((tile) => (
        <div class:list={['tile', tile.span, { ph: !tile.img }]}>{tile.img ? <Image src={tile.img} alt="" width={900} /> : g.placeholder_label}</div>
      ))}</div>
    </div></section>
  ))}
</Base>
<style>
  .section.grey{background:#f2f2f2;color:black}
  h2.h{font-size:clamp(2.6rem,5vw,4.5rem);text-transform:uppercase;color:var(--navy);margin-bottom:24px;line-height:.9}
  .grid{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:220px;gap:12px}
  .tile{overflow:hidden}
  .tile.big{grid-column:span 2;grid-row:span 2}
  .tile.wide{grid-column:span 2}
  .tile :global(img){width:100%;height:100%;object-fit:cover}
  .tile.ph{display:flex;align-items:center;justify-content:center;background:#e3e8eb;border:2px dashed var(--navy);color:var(--navy);font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase}
  @media (max-width:800px){.grid{grid-template-columns:repeat(2,1fr);grid-auto-rows:160px}}
</style>
