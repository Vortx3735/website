---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/libre-franklin/900.css';
import '../styles/global.css';
import { settings, posts } from '../lib/content';
const site = await settings();
const hasBlog = (await posts()).length > 0;

interface Props { title?: string; description?: string; overlayHeader?: boolean }
const { title, description = 'FRC Team 3735 VorTX, the Klein ISD robotics team in Spring, Texas.', overlayHeader = false } = Astro.props;
const fullTitle = title ? `${title} · VorTX 3735` : 'VorTX 3735 · FRC robotics, Klein ISD';
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/robots/', label: 'Robots' },
  { href: '/awards/', label: 'Awards' },
  { href: '/join-us/', label: 'Join us' },
  { href: '/sponsors/', label: 'Sponsors' },
  ...(hasBlog ? [{ href: '/blog/', label: 'Blog' }] : []),
  { href: '/resources/', label: 'Resources' },
  { href: '/calendar/', label: 'Calendar' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL('/media/build-season-timelapse.jpg', Astro.site)}>
  <meta name="theme-color" content="#012131">
  <link rel="icon" href="/favicon.png">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class:list={['site-header', { overlay: overlayHeader }]}>
    <div class="wrap bar">
      <a href="/" class="logo" aria-label="VorTX 3735 home"><img src="/images/logotype-white.png" alt="VorTX 3735" width="150" height="40"></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
      <nav id="main-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="wrap cols">
      <div><b>Visit</b><span>{site.address_line_1}</span><span>{site.address_line_2}</span><span>{site.address_line_3}</span></div>
      <div><b>Team</b><a href="/our-mission/">Mission</a><a href="/our-history/">History</a><a href="/leadership/">Leadership</a><a href="/coaches-mentors/">Coaches &amp; mentors</a></div>
      <div><b>Help</b><a href="/faq/">FAQ</a><a href="/contact-us/">Contact us</a><a href="/support-us/">Support us</a></div>
      <div><b>Resources</b><a href="/resources/">All resources</a><a href="/docs/">Programming docs</a><a href={site.brand_guide_link}>Branding</a></div>
    </div>
    <div class="wrap legal">© 2011–{new Date().getFullYear()} FRC VorTX 3735. All rights reserved.</div>
  </footer>
  <script>
    const b = document.querySelector('.menu-btn'), n = document.getElementById('main-nav');
    b?.addEventListener('click', () => { const o = n.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
  </script>
</body>
</html>
<style>
  .site-header{background:var(--deep);position:relative;z-index:10}
  .site-header.overlay{position:absolute;inset:0 0 auto;background:transparent}
  .bar{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:20px 0}
  .logo img{height:40px;width:auto}
  .menu-btn{display:none;background:none;border:0;color:inherit;cursor:pointer;width:44px;height:44px;place-items:center;border-radius:4px}
  .menu-btn svg{width:24px;height:24px}
  nav{display:flex;gap:28px}
  nav a{white-space:nowrap;font:600 14px/1 var(--body);letter-spacing:.12em;text-transform:uppercase;text-decoration:none;padding:12px 0;opacity:.9;transition:color .2s}
  nav a:hover,nav a[aria-current]{color:var(--green);opacity:1}
  @media (max-width:1180px){nav{gap:20px}nav a{letter-spacing:.08em}}
  @media (max-width:980px){
    .menu-btn{display:grid}
    .menu-btn[aria-expanded="true"]{background:var(--navy)}
    nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;gap:0;background:var(--deep);padding:8px var(--gutter) 20px;border-top:1px solid rgba(155,206,225,.18)}
    nav.open{display:flex}
    nav a{padding:16px 0;border-bottom:1px solid rgba(155,206,225,.12)}
  }
  .site-footer{border-top:1px solid rgba(155,206,225,.18);padding:48px 0 32px;font-size:15px;color:var(--lgrey)}
  .cols{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
  .cols div{display:flex;flex-direction:column;gap:6px}
  .cols b{color:var(--white);letter-spacing:.1em;text-transform:uppercase;font-size:13px;margin-bottom:4px}
  .cols a{text-decoration:none}
  .cols a:hover{color:var(--green)}
  .legal{margin-top:36px;font-size:13px}
  @media (max-width:860px){.cols{grid-template-columns:1fr 1fr}}
</style>
