---
import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/libre-franklin/800.css';
import '@fontsource/libre-franklin/900.css';
import '../styles/global.css';
import { settings, posts, text } from '../lib/content';
const site = await settings();
const t = await text('site');
const hasBlog = (await posts()).length > 0;

interface Props { title?: string; description?: string }
const { title, description = t.description } = Astro.props;
const fullTitle = title ? `${title} · ${t.title_suffix}` : t.home_title;
type Item = { href: string; label: string };
// One flat row of tabs, same order as the design. About's subpages (mission, history, leadership, coaches and mentors) are linked from the About page, and the programming docs from Resources.
const nav: Item[] = [
  ...(t.tabs as Item[]),
  ...(hasBlog ? [{ href: '/blog/', label: t.blog_tab_label }] : []),
];
const socials = [
  { label: 'Instagram', href: site.instagram_link },
  { label: 'YouTube', href: site.youtube_link },
  { label: 'Facebook', href: site.facebook_link },
  { label: 'X', href: site.x_link },
].filter((l) => l.href);
const path = Astro.url.pathname;
const aboutPages = ['/about/', '/our-mission/', '/our-history/', '/leadership/', '/coaches-mentors/'];
const isCurrent = (n: Item) => n.href === '/' ? path === '/'
  : n.href === '/about/' ? aboutPages.some((h) => path.startsWith(h))
  : n.href === '/resources/' ? path.startsWith('/resources/') || path.startsWith('/docs/')
  : path.startsWith(n.href);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL('/images/arena-hero.jpg', Astro.site)}>
  <meta name="theme-color" content="#012131">
  <link rel="icon" href="/favicon.png">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="logo" aria-label="VorTX 3735 home"><img src="/images/logotype-white.png" alt="VorTX 3735" width="150" height="40"></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
      <nav id="main-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={isCurrent(n) ? 'page' : undefined}>{n.label}</a>)}
        <a class="mob" href="/support-us/">{t.support_label}</a><a class="mob" href="/join-us/">{t.join_label}</a>
      </nav>
      <div class="ctas"><a class="btn btn-line" href="/support-us/">{t.support_label}</a><a class="btn btn-go" href="/join-us/">{t.join_label}</a></div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="wrap row">
      <a href="/" class="logo" aria-label="VorTX 3735 home"><img src="/images/logotype-white.png" alt="VorTX 3735" width="180" height="48"></a>
      <ul class="links" aria-label="Social links and contact">
        {socials.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
        <li><a class="mail" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>{t.email_label}</a></li>
        <li><a class="sup" href="/support-us/">{t.support_label}</a></li>
      </ul>
    </div>
    <div class="wrap legal">© {t.start_year} - {new Date().getFullYear()} {t.copyright}</div>
  </footer>
  <script>
    const b = document.querySelector('.menu-btn'), n = document.getElementById('main-nav');
    b?.addEventListener('click', () => { const o = n.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
  </script>
</body>
</html>
<style>
  .site-header{background:var(--navy);position:sticky;top:0;z-index:50;box-shadow:0 4px 0 var(--green);view-transition-name:site-header}
  .site-header .wrap{width:min(1400px,100% - 32px)}
  .bar{display:flex;align-items:center;gap:20px;padding:14px 0}
  .logo{flex:none}
  .logo img{height:40px;width:auto;max-width:none}
  .menu-btn{display:none;background:none;border:0;color:inherit;cursor:pointer;width:44px;height:44px;place-items:center;margin-left:auto}
  .menu-btn svg{width:24px;height:24px}
  nav{display:flex;align-items:center;gap:6px;margin-inline:auto 0}
  nav>a{position:relative;white-space:nowrap;font:900 14px/1 var(--head);letter-spacing:.06em;text-transform:uppercase;text-decoration:none;padding:20px 10px;transition:color .2s,transform .2s}
  nav>a:hover{color:var(--green);transform:translateY(-3px)}
  nav>a[aria-current]{color:var(--green)}
  /* The green bar under the current tab. With view transitions it slides from tab to tab as you move between pages. */
  nav>a[aria-current]::after{content:"";position:absolute;left:0;right:0;bottom:-14px;height:6px;background:var(--green);view-transition-name:tab-bar}
  .ctas{display:flex;gap:10px}
  .ctas .btn{padding:13px 20px;font-size:13px}
  .mob{display:none}
  @media (prefers-reduced-motion:reduce){nav>a{transition:none}nav>a:hover{transform:none}}
  @media (max-width:1320px){.ctas .btn-line{display:none}}
  @media (max-width:1180px){
    .mob{display:block}
    .menu-btn{display:grid}
    .menu-btn[aria-expanded="true"]{background:var(--deep)}
    .ctas{display:none}
    nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;align-items:stretch;gap:0;background:var(--navy);padding:8px var(--gutter) 20px;box-shadow:0 4px 0 var(--green)}
    nav.open{display:flex}
    nav>a{padding:16px 0}
    nav>a:hover{transform:none}
    nav>a[aria-current]::after{display:none}
  }
  .site-footer{background:var(--navy);padding:44px 0 32px;font-size:15px;position:relative;z-index:2}
  .site-footer .row{display:flex;flex-wrap:wrap;gap:20px 36px;justify-content:space-between;align-items:center}
  .site-footer .logo img{height:48px}
  .links{list-style:none;display:flex;flex-wrap:wrap;align-items:center;gap:10px 24px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:13px}
  .links a{text-decoration:underline}
  .links a:hover{color:var(--green)}
  .links .sup{color:var(--green);text-decoration:none}
  .legal{margin-top:28px;font-size:13px}
</style>
