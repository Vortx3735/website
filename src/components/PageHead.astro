---
import Rings from './Rings.astro';
interface Props { title: string; lead?: string; eyebrow?: string }
const { title, lead, eyebrow } = Astro.props;
// The last word of the title is green.
const words = title.split(' ');
const last = words.pop();
---
<section class="page-head">
  <Rings />
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="outline reveal">{words.join(' ')}{words.length > 0 && ' '}<em>{last}</em></h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
