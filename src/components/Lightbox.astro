---
// Put once on any page that uses PhotoScroller. Wires up the arrows, the wrap-around and the expanded photo view.
---
<dialog id="lightbox" aria-label="Expanded photo">
  <button type="button" class="x" aria-label="Close">×</button>
  <img alt="" />
</dialog>
<script>
  const box0 = document.getElementById('lightbox') as HTMLDialogElement;
  const big = box0.querySelector('img')!;
  box0.addEventListener('click', (e) => { if (e.target !== big) box0.close(); });
  document.querySelectorAll<HTMLElement>('.media').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.track')!;
    const count = box.querySelector<HTMLElement>('.count');
    const n = track.children.length;
    const reduce = () => (matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth') as ScrollBehavior;
    const idx = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (d: number) => {
      const next = idx() + d;
      if (next >= n) track.scrollTo({ left: 0, behavior: reduce() });
      else if (next < 0) track.scrollTo({ left: (n - 1) * track.clientWidth, behavior: reduce() });
      else track.scrollBy({ left: d * track.clientWidth, behavior: reduce() });
    };
    box.querySelector('.prev')?.addEventListener('click', () => go(-1));
    box.querySelector('.next')?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => { if (count) count.textContent = `${idx() + 1} / ${n}`; }, { passive: true });
    const open = () => {
      const slide = track.children[idx()] as HTMLElement;
      if (!slide.dataset.full) return;
      big.src = slide.dataset.full;
      big.alt = slide.querySelector('img')?.alt ?? '';
      box0.showModal();
    };
    box.querySelector('.zoom')?.addEventListener('click', open);
    track.addEventListener('click', open);
  });
</script>
<style>
  #lightbox{border:0;padding:0;background:transparent;max-width:none;max-height:none;width:100vw;height:100vh;overflow:hidden}
  #lightbox::backdrop{background:rgba(1,33,49,.92)}
  #lightbox[open]{display:grid;place-items:center}
  #lightbox img{max-width:min(94vw,1600px);max-height:90vh;object-fit:contain;border-bottom:6px solid var(--green)}
  #lightbox .x{position:absolute;top:16px;right:16px;width:48px;height:48px;border:0;background:var(--green);color:var(--navy);font:900 32px/1 var(--head);cursor:pointer}
</style>
