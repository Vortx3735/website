---
// A robot's photos: scroll with the arrows or by swiping, wraps around, and expands in the lightbox (see Lightbox.astro).
import { Image } from 'astro:assets';
import type { RobotPhotos } from '../lib/content';
// auto: seconds between automatic slides (leave out for none). It pauses while someone hovers, focuses or has the expanded view open.
interface Props { robot: RobotPhotos; width?: number; eager?: boolean; auto?: number }
const { robot: r, width = 700, eager = false, auto = 0 } = Astro.props;
---
<div class="media" data-auto={auto > 0 && r.imgs.length > 1 ? auto : undefined}>
  <div class="track" tabindex={r.imgs.length > 1 ? 0 : undefined} aria-label={r.imgs.length > 1 ? `${r.name} photos` : undefined}>
    {r.imgs.length === 0 && <div class="slide"></div>}
    {r.imgs.map((img, i) => <div class="slide" data-full={r.full[i]}><Image src={img} alt={`${r.name}, our ${r.year} robot${r.imgs.length > 1 ? `, photo ${i + 1} of ${r.imgs.length}` : ''}`} width={width} loading={eager && i === 0 ? 'eager' : 'lazy'} /></div>)}
  </div>
  {r.imgs.length > 0 && <button type="button" class="zoom" aria-label={`Expand ${r.name} photo`}>⤢</button>}
  {r.imgs.length > 1 && <>
    <button type="button" class="nav prev" aria-label="Previous photo">‹</button>
    <button type="button" class="nav next" aria-label="Next photo">›</button>
    <span class="count" aria-hidden="true">1 / {r.imgs.length}</span>
  </>}
</div>
<style>
  .media{position:relative;aspect-ratio:3/2;border-bottom:6px solid var(--green)}
  .track{display:flex;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain;cursor:zoom-in}
  .track::-webkit-scrollbar{display:none}
  .slide{flex:0 0 100%;height:100%;scroll-snap-align:start;background:#e3e8eb}
  .slide :global(img){width:100%;height:100%;object-fit:cover;display:block}
  .nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border:0;background:var(--navy);color:var(--white);font:900 26px/1 var(--head);cursor:pointer;opacity:.9}
  /* The arrows appear when the mouse is over the photo or a key press focuses them. Touch screens always show them. */
  @media (hover:hover){.nav{opacity:0;pointer-events:none;transition:opacity .2s}.media:hover .nav,.media:focus-within .nav{opacity:.9;pointer-events:auto}}
  .nav:hover,.nav:focus-visible{background:var(--green);color:var(--navy)}
  .prev{left:0}.next{right:0}
  .count{position:absolute;right:0;bottom:0;background:var(--navy);color:var(--white);font:700 12px/1 var(--body);letter-spacing:.1em;padding:6px 10px}
  .zoom{position:absolute;top:8px;right:8px;width:40px;height:40px;border:0;background:var(--navy);color:var(--white);font-size:22px;line-height:1;cursor:zoom-in;opacity:0;transition:opacity .2s}
  .media:hover .zoom,.zoom:focus-visible{opacity:.95}
  .zoom:hover{background:var(--green);color:var(--navy)}
  @media (hover:none){.zoom{opacity:.95}}
</style>
